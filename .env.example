# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
# Comma-separated allowlist, e.g. https://app.example.com,https://admin.example.com
CORS_ORIGIN=https://app.example.com
TRUST_PROXY=true
# Docs are disabled in production by default; set true only for staging/debug.
SWAGGER_ENABLED=false
# Set false on extra API replicas so cron jobs run exactly once.
WORKERS_ENABLED=true
SCHEDULER_ENABLED=true
BODY_LIMIT=1mb

# ---------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------
DATABASE_URL=postgresql://spectra:CHANGE_ME@postgres:5432/spectra?schema=public
POSTGRES_DB=spectra
POSTGRES_USER=spectra
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_PASSWORD

# ---------------------------------------------------------------
# Authentication (generate with: openssl rand -hex 32)
# ---------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_32_BYTES_HEX_MINIMUM
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_32_BYTES_HEX
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ---------------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------------
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_PASSWORD
API_HOST_PORT=3000

# ---------------------------------------------------------------
# Firebase Cloud Messaging (service account)
# ---------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------
MAX_FILE_SIZE_BYTES=5242880

# ---------------------------------------------------------------
# Attendance / working hours
# ---------------------------------------------------------------
GPS_ATTENDANCE_ENABLED=false
GPS_ATTENDANCE_RADIUS_METERS=500
DEFAULT_WORK_START_TIME=09:00
DEFAULT_WORK_END_TIME=18:00
LATE_THRESHOLD_MINUTES=15
MIN_HALF_DAY_MINUTES=240
APP_TIMEZONE=Asia/Kolkata
